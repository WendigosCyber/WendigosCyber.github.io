    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #0d1117;
            color: #c9d1d9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            padding: 20px;
            direction: rtl;
        }
        .container {
            background: #161b22;
            border-radius: 16px;
            padding: 30px;
            width: 100%;
            max-width: 1400px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.4);
        }
        h1 {
            text-align: center;
            margin-bottom: 25px;
            color: #58a6ff;
            font-size: 2rem;
        }
        .disclaimer {
            background: #2d1b1b;
            border: 1px solid #f85149;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 25px;
            color: #f85149;
            text-align: center;
            font-size: 0.9rem;
            line-height: 1.8;
        }
        .disclaimer strong {
            display: block;
            font-size: 1rem;
            margin-bottom: 5px;
        }
        .step-indicator {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
            gap: 10px;
        }
        .step {
            flex: 1;
            text-align: center;
            padding: 12px;
            background: #21262d;
            border-radius: 8px;
            border: 2px solid #30363d;
            transition: all 0.3s;
            position: relative;
        }
        .step.active {
            background: #1f2a37;
            border-color: #58a6ff;
            color: #58a6ff;
            font-weight: bold;
        }
        .step.done {
            background: #1b3a2b;
            border-color: #3fb950;
            color: #3fb950;
        }
        .step-num {
            display: inline-block;
            width: 28px;
            height: 28px;
            line-height: 28px;
            border-radius: 50%;
            background: #30363d;
            margin-left: 8px;
            font-weight: bold;
        }
        .step.active .step-num { background: #58a6ff; color: #0d1117; }
        .step.done .step-num { background: #3fb950; color: #0d1117; }

        .step-content {
            display: none;
            animation: fadeIn 0.4s ease;
        }
        .step-content.visible { display: block; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .controls {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 20px;
            align-items: flex-end;
            justify-content: center;
        }
        .control-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        .control-group label {
            font-size: 0.85rem;
            color: #8b949e;
        }
        .controls input[type="text"],
        .controls input[type="url"],
        .controls input[type="number"],
        .controls select {
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid #30363d;
            background: #0d1117;
            color: #c9d1d9;
            font-size: 0.95rem;
            outline: none;
            transition: border 0.2s;
            min-width: 200px;
        }
        .controls input:focus,
        .controls select:focus {
            border-color: #58a6ff;
        }
        .controls button {
            padding: 10px 20px;
            border-radius: 8px;
            border: none;
            background: #238636;
            color: white;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
            height: fit-content;
            align-self: flex-end;
        }
        .controls button.secondary {
            background: #30363d;
        }
        .controls button:hover:not(:disabled) {
            background: #2ea043;
        }
        .controls button.secondary:hover:not(:disabled) {
            background: #484f58;
        }
        .controls button:disabled {
            background: #21262d;
            color: #6e7681;
            cursor: not-allowed;
        }

        .progress-container {
            margin: 20px 0;
            background: #21262d;
            border-radius: 10px;
            overflow: hidden;
            height: 28px;
        }
        .progress-bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #238636, #58a6ff);
            transition: width 0.3s;
            text-align: center;
            line-height: 28px;
            color: white;
            font-size: 0.85rem;
            font-weight: bold;
        }

        .results-table {
            overflow-x: auto;
            margin-top: 15px;
            max-height: 500px;
            overflow-y: auto;
            border: 1px solid #30363d;
            border-radius: 8px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }
        th, td {
            padding: 10px 12px;
            text-align: right;
            border-bottom: 1px solid #30363d;
        }
        th {
            background: #21262d;
            color: #58a6ff;
            position: sticky;
            top: 0;
            z-index: 1;
        }
        tbody tr:hover td {
            background: #1c2128;
        }
        .selectable-row {
            cursor: pointer;
        }
        .selectable-row.selected td {
            background: #1b3a2b !important;
            border-right: 3px solid #3fb950;
        }
        .result-link {
            color: #58a6ff;
            text-decoration: none;
        }
        .result-domain {
            color: #8b949e;
            font-size: 0.8rem;
        }
        .status-success { color: #3fb950; font-weight: bold; }
        .status-fail { color: #f85149; font-weight: bold; }
        .status-unknown { color: #d29922; }

        .summary {
            margin-top: 20px;
            padding: 20px;
            background: #0d1117;
            border-radius: 8px;
            border: 1px solid #30363d;
            display: flex;
            flex-wrap: wrap;
            gap: 25px;
            justify-content: space-around;
        }
        .summary-item {
            text-align: center;
            min-width: 120px;
        }
        .summary-item span {
            display: block;
            font-size: 1.6rem;
            color: #58a6ff;
            font-weight: bold;
            margin-top: 5px;
        }
        .summary-item .label {
            color: #8b949e;
            font-size: 0.85rem;
        }

        .error-msg {
            background: #2d1b1b;
            border: 1px solid #f85149;
            color: #f85149;
            padding: 12px;
            border-radius: 8px;
            margin: 15px 0;
            text-align: center;
        }
        .info-msg {
            background: #1b2a3d;
            border: 1px solid #58a6ff;
            color: #58a6ff;
            padding: 12px;
            border-radius: 8px;
            margin: 15px 0;
            text-align: center;
        }
        .warning-msg {
            background: #3a2d1b;
            border: 1px solid #d29922;
            color: #d29922;
            padding: 12px;
            border-radius: 8px;
            margin: 15px 0;
            text-align: center;
        }

        .fallback-box {
            background: #21262d;
            padding: 15px;
            border-radius: 8px;
            margin-top: 15px;
            border: 1px dashed #30363d;
        }
        .log-box {
            background: #0d1117;
            border: 1px solid #30363d;
            border-radius: 8px;
            padding: 10px;
            margin-top: 15px;
            max-height: 150px;
            overflow-y: auto;
            font-family: 'Courier New', monospace;
            font-size: 0.8rem;
            direction: ltr;
            text-align: left;
        }
        .log-line { padding: 2px 5px; }
        .log-line.error { color: #f85149; }
        .log-line.success { color: #3fb950; }
