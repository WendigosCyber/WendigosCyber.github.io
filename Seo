<body>
    <div class="container">
        <h1>🚀 داشبورد حرفه‌ای سئو - شبیه‌ساز جستجو و کلیک گوگل</h1>

        <div class="disclaimer">
            <strong>⚠️ هشدار بسیار مهم - فقط برای اهداف آزمایشی و آموزشی</strong>
            این پروژه متعلق به خود شرکت گوگل برای پیدا کردن مشکلات و آسیب‌پذیری‌های سیستم جستجوی آن است.
            استفاده از این ابزار برای دستکاری نتایج گوگل غیرقانونی بوده و ممکن است باعث جریمه، بن شدن آی‌پی، مسدود شدن دامنه یا مشکلات قانونی جدی شود.
            این ابزار فقط جهت تست داخلی و آزمایشی ساخته شده است. مسئولیت هرگونه استفاده دیگر بر عهده کاربر است.
        </div>

        <!-- Step Indicator -->
        <div class="step-indicator">
            <div class="step active" id="step1Indicator">
                <span class="step-num">۱</span> جستجو و استخراج نتایج
            </div>
            <div class="step" id="step2Indicator">
                <span class="step-num">۲</span> انتخاب هدف و پیکربندی
            </div>
            <div class="step" id="step3Indicator">
                <span class="step-num">۳</span> شبیه‌سازی و آمار
            </div>
        </div>

        <!-- Step 1: Search -->
        <div class="step-content visible" id="step1Content">
            <h2 style="color:#58a6ff; margin-bottom:15px;">🔎 مرحله ۱: عبارت جستجو را وارد کنید</h2>
            <div class="controls">
                <div class="control-group" style="flex:1; min-width:300px;">
                    <label>عبارت جستجو (مثلاً: Light Kali)</label>
                    <input type="text" id="searchQuery" placeholder="Light Kali" value="Light Kali">
                </div>
                <button id="searchBtn">🔍 جستجو و دریافت نتایج</button>
            </div>
            <div id="searchStatus"></div>
            <div class="results-table" id="searchResultsContainer">
                <p style="text-align:center; color:#8b949e; padding:20px;">پس از جستجو، نتایج واقعی گوگل در اینجا نمایش داده می‌شود...</p>
            </div>
        </div>

        <!-- Step 2: Configuration -->
        <div class="step-content" id="step2Content">
            <h2 style="color:#58a6ff; margin-bottom:15px;">⚙️ مرحله ۲: انتخاب هدف و تنظیمات</h2>

            <div id="targetSelection">
                <h3 style="color:#c9d1d9; margin-bottom:10px;">🎯 یکی از نتایج بالا را انتخاب کنید یا دامنه را دستی وارد نمایید:</h3>
                <div id="radioTargetsContainer"></div>

                <div class="fallback-box">
                    <div class="controls">
                        <div class="control-group" style="flex:1; min-width:250px;">
                            <label>یا دامنه هدف را دستی وارد کنید:</label>
                            <input type="text" id="manualDomain" placeholder="example.com">
                        </div>
                    </div>
                </div>
            </div>

            <div class="controls" style="margin-top:20px;">
                <div class="control-group">
                    <label>تکرار برای هر یوزر ایجنت</label>
                    <input type="number" id="repetitions" value="10" min="1" max="100">
                </div>
                <div class="control-group">
                    <label>تعداد درخواست همزمان</label>
                    <select id="concurrency">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100 (خطرناک ⚠️)</option>
                    </select>
                </div>
                <button id="startSimulationBtn" class="secondary">🚀 شروع شبیه‌سازی</button>
                <button id="backToSearchBtn" class="secondary">⬅️ بازگشت</button>
            </div>
        </div>

        <!-- Step 3: Simulation -->
        <div class="step-content" id="step3Content">
            <h2 style="color:#58a6ff; margin-bottom:15px;">📊 مرحله ۳: شبیه‌سازی و آمار</h2>

            <div class="info-msg" id="simInfo"></div>

            <div class="progress-container">
                <div class="progress-bar" id="progressBar">0%</div>
            </div>

            <h3 style="color:#c9d1d9; margin:15px 0 10px;">📋 آمار به ازای هر پروکسی:</h3>
            <div class="results-table" id="proxyStatsContainer">
                <p style="text-align:center; color:#8b949e; padding:20px;">در انتظار شروع شبیه‌سازی...</p>
            </div>

            <div class="summary" id="summary" style="display:none;">
                <div class="summary-item">
                    <div class="label">کل درخواست‌ها</div>
                    <span id="totalReq">0</span>
                </div>
                <div class="summary-item">
                    <div class="label">جستجوی موفق</div>
                    <span id="searchSuccessTotal" style="color:#3fb950;">0</span>
                </div>
                <div class="summary-item">
                    <div class="label">نتایج یافت شد</div>
                    <span id="foundResults" style="color:#d29922;">0</span>
                </div>
                <div class="summary-item">
                    <div class="label">کلیک موفق</div>
                    <span id="clickSuccess" class="status-success">0</span>
                </div>
                <div class="summary-item">
                    <div class="label">کلیک ناموفق</div>
                    <span id="clickFail" class="status-fail">0</span>
                </div>
                <div class="summary-item">
                    <div class="label">میانگین زمان (ms)</div>
                    <span id="avgTime">0</span>
                </div>
            </div>

            <div class="log-box" id="logBox"></div>

            <div class="controls" style="margin-top:15px;">
                <button id="restartBtn" class="secondary">🔄 شروع دوباره از ابتدا</button>
            </div>
        </div>
    </div>

