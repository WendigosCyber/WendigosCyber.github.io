                    html += `
                        <tr>
                            <td style="max-width:200px; overflow:hidden; text-overflow:ellipsis;">${escapeHtml(s.name)}</td>
                            <td>${s.count}</td>
                            <td class="status-success">${s.searchSuccess}</td>
                            <td class="status-unknown">${s.found}</td>
                            <td class="status-success">${s.clickSuccess}</td>
                            <td class="status-fail">${s.clickFail}</td>
                            <td>${avg}</td>
                        </tr>`;
                });
                html += '</tbody></table>';
                proxyStatsContainer.innerHTML = html;
            }

            async function runTask(task) {
                const startTime = performance.now();
                const stat = proxyStats.get(task.proxy.name);
                stat.count++;

                try {
                    // 1. جستجو از طریق پروکسی
                    const proxySearchUrl = buildProxyUrl(task.proxy.template, task.searchUrl);
                    let searchResponse;
                    try {
                        searchResponse = await fetchWithTimeout(proxySearchUrl, 12000);
                    } catch (e) {
                        stat.searchFail++;
                        addLog(`خطای جستجو: ${task.proxy.name} - ${e.message || 'timeout'}`, 'error');
                        return;
                    }

                    if (!searchResponse.ok) {
                        stat.searchFail++;
                        return;
                    }

                    const searchText = await searchResponse.text();
                    stat.searchSuccess++;
                    searchSuccessTotal++;

                    // بررسی وجود دامنه هدف
                    const targetDomainLower = task.target.domain.toLowerCase();
                    const searchTextLower = searchText.toLowerCase();
                    const domainFound = searchTextLower.includes(targetDomainLower);

                    if (domainFound) {
                        stat.found++;
                        foundCount++;
                        addLog(`✅ یافت شد در: ${task.proxy.name}`, 'success');

                        // 2. شبیه‌سازی کلیک
                        let targetUrl = task.target.url;
                        if (!targetUrl.startsWith('http')) {
                            targetUrl = `https://${targetDomainLower}`;
                        }
                        const proxyClickUrl = buildProxyUrl(task.proxy.template, targetUrl);

                        try {
                            const clickResponse = await fetchWithTimeout(proxyClickUrl, 10000);
                            if (clickResponse.ok) {
                                stat.clickSuccess++;
                                clickSuccessCount++;
                            } else {
                                stat.clickFail++;
                                clickFailCount++;
                            }
                        } catch (e) {
                            // تلاش با http اگر https کار نکرد
                            try {
                                const httpUrl = buildProxyUrl(task.proxy.template, `http://${targetDomainLower}`);
                                const httpResp = await fetchWithTimeout(httpUrl, 10000);
                                if (httpResp.ok) {
                                    stat.clickSuccess++;
                                    clickSuccessCount++;
                                } else {
                                    stat.clickFail++;
                                    clickFailCount++;
                                }
                            } catch (e2) {
                                stat.clickFail++;
                                clickFailCount++;
                            }
                        }
                    }
                } catch (err) {
                    stat.searchFail++;
                } finally {
                    const endTime = performance.now();
                    const elapsed = endTime - startTime;
                    stat.totalTime += elapsed;
                    totalTimeSum += elapsed;
                    completed++;
                    updateProgress();
                    // به‌روزرسانی آمار هر 5 وظیفه
                    if (completed % 5 === 0) renderProxyStats();
                }
            }

            // مدیریت صف با worker ها
            const queue = [...tasks];
            const workers = [];
            const workerCount = Math.min(concurrency, queue.length);

            async function worker() {
                while (queue.length > 0) {
                    const task = queue.shift();
                    if (task) await runTask(task);
                }
            }

            for (let i = 0; i < workerCount; i++) {
                workers.push(worker());
            }

            await Promise.all(workers);

            // نمایش نهایی
            renderProxyStats();
            document.getElementById('totalReq').textContent = totalTasks;
            document.getElementById('searchSuccessTotal').textContent = searchSuccessTotal;
            document.getElementById('foundResults').textContent = foundCount;
            document.getElementById('clickSuccess').textContent = clickSuccessCount;
            document.getElementById('clickFail').textContent = clickFailCount;
            const avgTotal = totalTasks > 0 ? (totalTimeSum / totalTasks).toFixed(1) : 0;
            document.getElementById('avgTime').textContent = avgTotal;
            summaryDiv.style.display = 'flex';

            addLog(`✅ شبیه‌سازی کامل شد. ${totalTasks} وظیفه اجرا شد.`, 'success');
            progressBar.textContent = `✅ کامل شد (${totalTasks}/${totalTasks})`;
        }

        document.getElementById('restartBtn').addEventListener('click', () => {
            extractedResults = [];
            selectedTarget = null;
            goToStep(0);
            searchResultsContainer.innerHTML = '<p style="text-align:center; color:#8b949e; padding:20px;">پس از جستجو، نتایج واقعی گوگل در اینجا نمایش داده می‌شود...</p>';
            searchStatus.innerHTML = '';
        });

        // شروع با مرحله ۱
        goToStep(0);
    </script>
</body>
</html>
