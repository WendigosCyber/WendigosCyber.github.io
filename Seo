            const params = new URLSearchParams();
            params.append('q', query);
            params.append('oq', query);
            params.append('gs_lcrp', gs_lcrp);
            params.append('client', isMobile ? 'ms-android-samsung-ss' : 'firefox-b-d');
            params.append('sourceid', isMobile ? 'chrome-mobile' : 'firefox-b-d');
            params.append('ie', 'UTF-8');
            params.append('hl', 'en');
            params.append('num', '20');
            // پارامتر تصادفی برای جلوگیری از کش
            params.append('_rnd', randomString(8));
            return `https://www.google.com/search?${params.toString()}`;
        }

        function extractResultsFromHtml(html) {
            const results = [];
            const seenUrls = new Set();

            try {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');

                // تلاش اول: پیدا کردن لینک‌های استاندارد گوگل
                const anchors = doc.querySelectorAll('a[href*="/url?q="]');
                anchors.forEach(a => {
                    const href = a.getAttribute('href') || '';
                    const match = href.match(/\/url\?q=([^&]+)/);
                    if (match && match[1]) {
                        const url = decodeURIComponent(match[1]);
                        if (url.startsWith('http') && !url.includes('google.com') && !url.includes('youtube.com') && !seenUrls.has(url)) {
                            // استخراج دامنه
                            let domain = url;
                            try {
                                domain = new URL(url).hostname;
                            } catch(e) {}
                            const title = a.textContent.trim().replace(/\s+/g, ' ').substring(0, 120);
                            if (title && title.length > 2 && domain && !domain.includes('google.')) {
                                results.push({ url, domain, title });
                                seenUrls.add(url);
                            }
                        }
                    }
                });
            } catch (e) {
                console.warn('DOMParser failed, falling back to regex', e);
            }

            // Fallback: regex
            if (results.length === 0) {
                const regex = /\/url\?q=([^"&]+)["&]/g;
                let m;
                while ((m = regex.exec(html)) !== null) {
                    try {
                        const url = decodeURIComponent(m[1]);
                        if (url.startsWith('http') && !url.includes('google.com') && !seenUrls.has(url)) {
                            let domain = url;
                            try { domain = new URL(url).hostname; } catch(e) {}
                            if (domain && !domain.includes('google.')) {
                                results.push({ url, domain, title: domain });
                                seenUrls.add(url);
                            }
                        }
                    } catch(e) {}
                }
            }

            return results;
        }

