            // ساخت صف وظایف
            const tasks = [];
            for (let uaIdx = 0; uaIdx < userAgents.length; uaIdx++) {
                for (let rep = 0; rep < repetitions; rep++) {
                    const randomProxy = proxies[Math.floor(Math.random() * proxies.length)];
                    const ua = userAgents[uaIdx];
                    const isMobile = /Mobile|Android|iPhone|iPad/i.test(ua);
                    tasks.push({
                        proxy: randomProxy,
                        userAgent: ua,
                        isMobile,
                        searchUrl: generateGoogleSearchUrl(query, isMobile),
                        target
                    });
                }
            }

            const totalTasks = tasks.length;
            let completed = 0;
            let totalTimeSum = 0;
            let foundCount = 0;
            let clickSuccessCount = 0;
            let clickFailCount = 0;
            let searchSuccessTotal = 0;

            function updateProgress() {
                const percent = Math.round((completed / totalTasks) * 100);
                progressBar.style.width = percent + '%';
                progressBar.textContent = `${percent}% (${completed}/${totalTasks})`;
            }

            function renderProxyStats() {
                const used = [...proxyStats.values()].filter(s => s.count > 0)
                    .sort((a,b) => b.count - a.count);
                if (used.length === 0) {
